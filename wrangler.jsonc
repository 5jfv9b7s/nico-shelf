{
  "name": "nico-shelf",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_MYLIST_RATE_LIMIT",
      "namespace_id": "1601621",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "main": "worker/index.js",
  "keep_vars": true,
  "vars": {
    "PUBLIC_MYLIST_SOURCE": "gateway",
    "PUBLIC_MYLIST_GATEWAY_URL": "https://nico-shelf.onrender.com/"
  }
}
